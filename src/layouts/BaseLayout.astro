---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Optional JSON-LD graph objects merged into page schema */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  path?: string;
}

const {
  title = 'Zetta CRM — Self-hosted CRM for AI agents',
  description = 'Self-hosted Go MCP server with 75 tools: contacts, email, campaigns, inbox, WhatsApp, Threads, LinkedIn, X, tracking, scheduling, and analytics. One binary, one MySQL database, one Docker image.',
  jsonLd,
  ogType = 'website',
  path,
} = Astro.props;

const site = 'https://zettacrm.com';
const ogImage = `${site}/og.png`;
const canonical = path ? new URL(path, site).href : Astro.url.href;

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Zetta CRM',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Linux, Docker',
  description,
  url: site,
  image: ogImage,
  author: {
    '@type': 'Organization',
    name: 'Incredible Zetta',
    url: 'https://github.com/incredible-zetta',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  license: 'https://opensource.org/licenses/MIT',
};

const extra = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

const schema = [softwareLd, ...extra];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/zetta-mark.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
    <link rel="alternate" type="text/plain" href="/llms-install.txt" title="Install LLMs.txt" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta name="keywords" content="CRM, AI agents, MCP, self-hosted, open-source, Go, Docker, install, contacts, email, campaigns, WhatsApp, Threads, LinkedIn, Model Context Protocol, GHCR" />
    <meta name="author" content="Incredible Zetta" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="geo.region" content="ID" />
    <meta name="geo.placename" content="Indonesia" />
    <meta name="language" content="en" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Zetta CRM" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schema.length === 1 ? schema[0] : schema)} />

    <!-- Apply stored theme before paint. Default: light. -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme !== 'light' && theme !== 'dark') theme = 'light';
          document.documentElement.classList.toggle('dark', theme === 'dark');
          document.documentElement.style.colorScheme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#0a0a0a' : '#ffffff');
        } catch (e) {
          document.documentElement.classList.remove('dark');
          document.documentElement.style.colorScheme = 'light';
        }
      })();
    </script>

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
