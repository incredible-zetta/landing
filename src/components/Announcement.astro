---
import Icon from '../lib/Icon.astro';
import { ANNOUNCEMENT } from '../lib/data';
import { getRepoMeta } from '../lib/github';
import { badgeVariants } from '~/components/ui/badge';
import { cn } from '~/lib/utils';

const { latest } = await getRepoMeta();
---

<div class="border-b border-border bg-muted/40">
  <div class="container-page flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 py-2.5 text-sm text-muted-foreground">
    <span class={cn(badgeVariants({ variant: 'secondary' }), 'gap-1.5')}>
      <Icon name="sparkles" size={12} />
      {latest.tag}
    </span>
    <span>
      <b class="font-medium text-foreground">{latest.tag} is live.</b>
      {' '}{ANNOUNCEMENT.suffix}
    </span>
    <a
      href={latest.url}
      class="inline-flex items-center gap-1 font-medium text-foreground underline-offset-4 hover:underline"
    >
      {ANNOUNCEMENT.cta} <Icon name="arrow-right" size={14} />
    </a>
  </div>
</div>
