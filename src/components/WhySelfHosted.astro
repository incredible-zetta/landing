---
import Icon from '../lib/Icon.astro';
import { WHY } from '../lib/data';
import { Card, CardDescription, CardHeader, CardTitle } from '~/components/ui/card';
---

<section id="why" class="container-page py-16">
  <div class="mb-8 max-w-2xl">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Why self-hosted</h2>
    <p class="mt-2 text-sm text-muted-foreground sm:text-base">
      Privacy is architecture — not a marketing badge.
    </p>
  </div>

  <div class="grid gap-3 sm:grid-cols-3">
    {WHY.map((w) => (
      <Card size="sm" className="h-full">
        <CardHeader>
          <span class="mb-2 inline-flex size-9 items-center justify-center rounded-lg bg-muted text-foreground">
            <Icon name={w.icon as any} size={18} />
          </span>
          <CardTitle>{w.title}</CardTitle>
          <CardDescription className="text-pretty leading-relaxed">
            {w.highlight ? (
              <>
                <span class="font-medium text-foreground">{w.highlight}</span>{' '}
                {w.desc.replace(w.highlight, '').trim()}
              </>
            ) : (
              w.desc
            )}
          </CardDescription>
        </CardHeader>
      </Card>
    ))}
  </div>
</section>
