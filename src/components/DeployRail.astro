---
import Icon from '../lib/Icon.astro';
import { DEPLOY_RAIL } from '../lib/data';
import { getRepoMeta, GHCR_IMAGE } from '../lib/github';
import { buttonVariants } from '~/components/ui/button';
import { badgeVariants } from '~/components/ui/badge';
import { cn } from '~/lib/utils';

const { latest } = await getRepoMeta();
---

<section id="deploy" class="border-b border-border py-20 sm:py-24">
  <div class="container-page">
    <div class="mb-10 max-w-2xl">
      <h2 data-reveal class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Deploy in one port
      </h2>
      <p data-reveal class="mt-3 text-base text-muted-foreground">
        Single container, MySQL 8, API key, done. Built for EasyPanel and any Docker host.
      </p>
    </div>

    <div data-reveal class="grid overflow-hidden border border-border lg:grid-cols-2">
      <div class="space-y-5 p-6 sm:p-8">
        <span class={cn(badgeVariants({ variant: 'secondary' }), 'w-fit gap-1.5')}>
          <Icon name="rocket" size={12} /> {latest.tag}
        </span>
        <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">
          Pull the GHCR image and point agents at <code class="font-mono text-[0.9em]">/mcp</code>.
        </h3>
        <p class="max-w-prose text-sm leading-relaxed text-muted-foreground">
          Set <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">MCP_API_KEY</code>, <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">DB_DSN</code>, and <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">BASE_URL</code>. Authenticate with Bearer or X-API-Key.
        </p>
        <div class="flex flex-wrap gap-2">
          <a href="/install" class={cn(buttonVariants())}>Install guide</a>
          <a href={latest.url} class={cn(buttonVariants({ variant: 'outline' }))}>Release notes</a>
        </div>
      </div>
      <div class="border-t border-border bg-muted/40 lg:border-l lg:border-t-0">
        <pre class="overflow-x-auto p-6 font-mono text-xs leading-6 text-muted-foreground sm:p-8"><code>docker pull {GHCR_IMAGE}:{latest.tag}

MCP_URL=https://crm.example.com/mcp
Authorization: Bearer $MCP_API_KEY</code></pre>
      </div>
    </div>

    <div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
      {DEPLOY_RAIL.map((r) => (
        <div data-reveal class="flex items-center gap-3 border border-border bg-background p-4">
          <span class="inline-flex size-8 shrink-0 items-center justify-center bg-muted text-foreground">
            <Icon name={r.icon as any} size={16} />
          </span>
          <div class="min-w-0">
            <p class="text-sm font-medium text-foreground">{r.title}</p>
            <p class="text-xs text-muted-foreground">{r.sub}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
