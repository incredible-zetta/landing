---
import Icon from '../lib/Icon.astro';
import { DEPLOY_RAIL } from '../lib/data';
import { getRepoMeta, WIKI_URL } from '../lib/github';
import { buttonVariants } from '~/components/ui/button';
import { badgeVariants } from '~/components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '~/components/ui/card';
import { cn } from '~/lib/utils';

const { latest } = await getRepoMeta();
---

<section id="deploy" class="container-page py-16">
  <div class="mb-8 max-w-2xl">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
      Deploy anywhere. You're in control.
    </h2>
    <p class="mt-2 text-sm text-muted-foreground sm:text-base">
      One container, one database, one MCP endpoint.
    </p>
  </div>

  <Card className="overflow-hidden">
    <div class="grid lg:grid-cols-2">
      <CardHeader className="gap-3 p-6 sm:p-8">
        <span class={cn(badgeVariants({ variant: 'secondary' }), 'w-fit gap-1.5')}>
          <Icon name="rocket" size={12} /> Stable release
        </span>
        <CardTitle className="text-xl sm:text-2xl">
          {latest.tag} ships as a multi-platform GHCR image.
        </CardTitle>
        <CardDescription className="max-w-prose text-sm leading-relaxed">
          Pull one container, connect MySQL 8, set <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">BASE_URL</code>, and expose <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">/mcp</code> to your agents behind API-key auth.
        </CardDescription>
        <div class="mt-2 flex flex-wrap gap-2">
          <a href={WIKI_URL} class={cn(buttonVariants())}>Install wiki</a>
          <a href={latest.url} class={cn(buttonVariants({ variant: 'outline' }))}>Release notes</a>
        </div>
      </CardHeader>
      <CardContent className="border-t border-border bg-muted/30 p-0 lg:border-l lg:border-t-0">
        <pre class="overflow-x-auto p-6 font-mono text-xs leading-6 text-muted-foreground sm:p-8"><code>docker pull ghcr.io/incredible-zetta/crm:{latest.tag}

MCP_URL=https://crm.example.com/mcp
Authorization: Bearer $MCP_API_KEY</code></pre>
      </CardContent>
    </div>
  </Card>

  <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {DEPLOY_RAIL.map((r) => (
      <Card size="sm">
        <CardHeader className="flex-row items-center gap-3 space-y-0">
          <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground">
            <Icon name={r.icon as any} size={16} />
          </span>
          <div class="min-w-0">
            <CardTitle className="text-sm">{r.title}</CardTitle>
            <CardDescription>{r.sub}</CardDescription>
          </div>
        </CardHeader>
      </Card>
    ))}
  </div>
</section>
