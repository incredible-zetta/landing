---
import Icon from '../lib/Icon.astro';
import { HERO } from '../lib/data';
import { getRepoMeta } from '../lib/github';
import { buttonVariants } from '~/components/ui/button';
import { cn } from '~/lib/utils';

const { latest } = await getRepoMeta();
---

<section class="relative isolate min-h-[min(100svh,56rem)] overflow-hidden border-b border-border">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-atmosphere"></div>
    <div
      data-parallax="0.35"
      class="absolute -right-[18%] top-[-10%] h-[70%] w-[70%] rounded-full bg-[radial-gradient(circle_at_center,oklch(0.75_0.02_240/0.35),transparent_65%)] blur-2xl dark:bg-[radial-gradient(circle_at_center,oklch(0.35_0.02_240/0.45),transparent_65%)]"
    ></div>
    <div
      data-parallax="-0.2"
      class="absolute -left-[20%] bottom-[-20%] h-[55%] w-[55%] rounded-full bg-[radial-gradient(circle_at_center,oklch(0.82_0.03_85/0.28),transparent_70%)] blur-2xl dark:bg-[radial-gradient(circle_at_center,oklch(0.28_0.02_85/0.35),transparent_70%)]"
    ></div>
    <div class="absolute inset-0 bg-grid-fade opacity-50 dark:opacity-30"></div>
  </div>

  <div class="container-page flex min-h-[min(100svh,56rem)] flex-col justify-end pb-16 pt-24 sm:pb-20 sm:pt-28">
    <p
      data-hero-brand
      class="mb-6 font-heading text-[clamp(3.5rem,14vw,9.5rem)] font-semibold leading-[0.88] tracking-[-0.06em] text-foreground"
    >
      {HERO.brand}
      <span class="text-muted-foreground">{HERO.brandAccent}</span>
    </p>

    <div class="grid max-w-3xl gap-6">
      <p data-hero-copy class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">
        {HERO.eyebrow}
      </p>
      <h1 data-hero-copy class="text-balance text-3xl font-semibold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
        {HERO.title}
      </h1>
      <p data-hero-copy class="max-w-2xl text-pretty text-base leading-relaxed text-muted-foreground sm:text-lg">
        {HERO.sub}
      </p>
      <div data-hero-copy class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <a class={cn(buttonVariants({ size: 'lg' }), 'min-h-11 w-full sm:w-auto')} href={HERO.primary.href}>
          <Icon name="rocket" size={16} /> {HERO.primary.label}
        </a>
        <a
          class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'min-h-11 w-full sm:w-auto')}
          href={latest.url}
          target="_blank"
          rel="noreferrer"
        >
          <Icon name="github" size={16} /> {latest.tag} on GitHub
        </a>
      </div>
    </div>
  </div>
</section>
