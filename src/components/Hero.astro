---
import Icon from '../lib/Icon.astro';
import { HERO, TRUST } from '../lib/data';
import { getRepoMeta } from '../lib/github';
import { buttonVariants } from '~/components/ui/button';
import { badgeVariants } from '~/components/ui/badge';
import { cn } from '~/lib/utils';

const { latest } = await getRepoMeta();
---

<header class="container-page relative pb-14 pt-12 text-center sm:pb-16 sm:pt-16">
  <span class={cn(badgeVariants({ variant: 'outline' }), 'mb-5 h-auto gap-2 px-3 py-1 text-[11px] uppercase tracking-[0.12em]')}>
    {HERO.eyebrow}
  </span>

  <h1 class="mx-auto mb-4 max-w-3xl text-balance text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
    {HERO.titleA}{' '}
    <span class="text-muted-foreground">{HERO.titleGradient}</span>{' '}
    {HERO.titleB}
  </h1>

  <p class="mx-auto mb-8 max-w-2xl text-pretty text-base leading-relaxed text-muted-foreground sm:text-lg">
    {HERO.sub}
  </p>

  <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
    <a class={cn(buttonVariants({ size: 'lg' }), 'min-h-11 w-full sm:w-auto')} href={HERO.primary.href}>
      <Icon name="rocket" size={16} /> Deploy {latest.tag}
    </a>
    <a class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'min-h-11 w-full sm:w-auto')} href={latest.url}>
      <Icon name="github" size={16} /> {HERO.secondary.label}
    </a>
  </div>

  <dl class="mx-auto mt-12 grid max-w-3xl gap-6 text-left sm:grid-cols-3 sm:gap-8">
    {TRUST.map((t) => (
      <div class="space-y-1.5">
        <dt class="flex items-center gap-2 text-sm font-medium text-foreground">
          <Icon name={t.icon as any} size={16} />
          {t.title}
        </dt>
        <dd class="text-sm leading-relaxed text-muted-foreground">{t.desc}</dd>
      </div>
    ))}
  </dl>
</header>
