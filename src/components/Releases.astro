---
import Icon from '../lib/Icon.astro';
import { getRepoMeta, WIKI_GUIDES, REPO_SLUG, REPO_URL, WIKI_URL, API_BASE, GHCR_IMAGE } from '../lib/github';
import { badgeVariants } from '~/components/ui/badge';
import { cn } from '~/lib/utils';

const { latest, tags, stars } = await getRepoMeta();

const fmtDate = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
---

<section id="releases" class="border-b border-border py-20 sm:py-24" data-repo-slug={REPO_SLUG} data-api={API_BASE} data-repo-url={REPO_URL}>
  <div class="container-page">
    <div class="mb-10 max-w-2xl">
      <h2 data-reveal class="text-3xl font-semibold tracking-tight sm:text-4xl">Releases &amp; docs</h2>
      <p data-reveal class="mt-3 text-base leading-relaxed text-muted-foreground">
        Live from{' '}
        <a href={REPO_URL} target="_blank" rel="noreferrer" class="font-medium text-foreground underline-offset-4 hover:underline">
          {REPO_SLUG}
        </a>
        . Tags refresh on every visit.
      </p>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <a
        href={latest.url}
        target="_blank"
        rel="noreferrer"
        data-latest-link
        data-reveal
        class="group block border border-border bg-background p-6 transition-colors hover:bg-muted/40 sm:p-8"
      >
        <span class={cn(badgeVariants({ variant: 'secondary' }), 'mb-4 w-fit gap-1.5')}>
          <Icon name="rocket" size={12} /> Latest release
        </span>
        <div class="mb-3 flex flex-wrap items-baseline gap-3">
          <p class="font-mono text-3xl font-semibold tracking-tight" data-latest-tag>{latest.tag}</p>
          <span data-latest-date class="text-xs text-muted-foreground">{fmtDate(latest.publishedAt)}</span>
        </div>
        <p class="text-sm leading-relaxed text-muted-foreground">
          Pull <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">{GHCR_IMAGE}:<span data-latest-tag-inline>{latest.tag}</span></code> and point your agents at <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">/mcp</code>.
        </p>
        <p class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-foreground">
          Read release notes <Icon name="arrow-up-right" size={14} />
        </p>
      </a>

      <div data-reveal class="border border-border bg-background p-6 sm:p-8">
        <div class="mb-5 flex items-center justify-between gap-3">
          <h3 class="text-lg font-semibold tracking-tight">Recent tags</h3>
          <a
            href={`${REPO_URL}/stargazers`}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground"
          >
            <Icon name="star" size={14} /> <span data-repo-stars>{stars}</span> stars
          </a>
        </div>
        <div data-tag-list class="flex flex-wrap gap-2">
          {tags.map((t) => (
            <a
              href={t.url}
              target="_blank"
              rel="noreferrer"
              class={cn(badgeVariants({ variant: 'outline' }), 'h-auto gap-1.5 px-3 py-1.5 font-mono')}
            >
              <Icon name="tag" size={12} /> {t.name}
            </a>
          ))}
        </div>
        <a
          href={`${REPO_URL}/tags`}
          target="_blank"
          rel="noreferrer"
          class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground"
        >
          All tags <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </div>

    <h3 id="docs" data-reveal class="mt-14 mb-4 text-sm font-semibold text-foreground">
      Install guides <span class="font-normal text-muted-foreground">— wiki + on-site</span>
    </h3>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      <a
        href="/install"
        data-reveal
        class="flex items-center gap-2.5 border border-border bg-background px-3.5 py-3 text-sm font-medium text-foreground transition-colors hover:bg-muted"
      >
        <span class="inline-flex size-5 shrink-0 items-center justify-center">
          <Icon name="book-open" size={16} />
        </span>
        Install page
      </a>
      {WIKI_GUIDES.map((g) => (
        <a
          href={g.href}
          target="_blank"
          rel="noreferrer"
          data-reveal
          class="flex items-center gap-2.5 border border-border bg-background px-3.5 py-3 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >
          <span class="inline-flex size-5 shrink-0 items-center justify-center text-foreground">
            <Icon name={g.icon as any} size={16} />
          </span>
          {g.label}
        </a>
      ))}
    </div>
    <a
      href={WIKI_URL}
      target="_blank"
      rel="noreferrer"
      class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground"
    >
      Open full wiki <Icon name="arrow-up-right" size={14} />
    </a>
  </div>
</section>

<script>
  const root = document.getElementById('releases');
  if (root) {
    const api = root.dataset.api!;
    const repoUrl = root.dataset.repoUrl!;
    const text = (sel: string, value: string) => {
      root.querySelectorAll<HTMLElement>(sel).forEach((el) => (el.textContent = value));
    };

    const refresh = async () => {
      try {
        const [relRes, tagsRes, repoRes] = await Promise.all([
          fetch(`${api}/releases/latest`),
          fetch(`${api}/tags`),
          fetch(api),
        ]);

        if (relRes.ok) {
          const rel = await relRes.json();
          if (rel?.tag_name) {
            text('[data-latest-tag]', rel.tag_name);
            text('[data-latest-tag-inline]', rel.tag_name);
            const link = root.querySelector<HTMLAnchorElement>('[data-latest-link]');
            if (link && rel.html_url) link.href = rel.html_url;
            if (rel.published_at) {
              text(
                '[data-latest-date]',
                new Date(rel.published_at).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                }),
              );
            }
          }
        }

        if (tagsRes.ok) {
          const tags = await tagsRes.json();
          const list = root.querySelector<HTMLElement>('[data-tag-list]');
          if (list && Array.isArray(tags) && tags.length) {
            list.innerHTML = tags
              .slice(0, 6)
              .map((t: { name: string }) => {
                const href = `${repoUrl}/releases/tag/${t.name}`;
                return `<a href="${href}" target="_blank" rel="noreferrer" class="group/badge inline-flex h-auto w-fit shrink-0 items-center justify-center gap-1.5 overflow-hidden rounded-4xl border border-border px-3 py-1.5 font-mono text-xs font-medium whitespace-nowrap transition-all hover:bg-muted hover:text-muted-foreground"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>${t.name}</a>`;
              })
              .join('');
          }
        }

        if (repoRes.ok) {
          const repo = await repoRes.json();
          if (typeof repo?.stargazers_count === 'number') {
            text('[data-repo-stars]', String(repo.stargazers_count));
          }
        }
      } catch {
        /* keep build-time values on failure */
      }
    };

    refresh();
  }
</script>
