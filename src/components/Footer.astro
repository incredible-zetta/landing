---
import Icon from '../lib/Icon.astro';
import { NAV } from '../lib/data';
import DirectoryBadges from './DirectoryBadges.astro';
import { Separator } from '~/components/ui/separator';
import { buttonVariants } from '~/components/ui/button';
import { cn } from '~/lib/utils';
---

<footer class="border-t border-border">
  <div class="container-page flex flex-col gap-8 py-10">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="space-y-2 lg:max-w-sm">
        <a href="/" class="inline-flex items-center gap-2.5">
          <img src="/zetta-mark.png" alt="Z" class="h-6 rounded-md" />
          <b class="text-sm font-semibold text-foreground">{NAV.brand}</b>
        </a>
        <p class="text-sm leading-relaxed text-muted-foreground">
          Open-source MCP CRM backend for AI agents. Self-hosted. 75 tools.
        </p>
      </div>

      <div class="flex flex-col gap-2">
        <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">
          Listed on
        </p>
        <DirectoryBadges />
      </div>

      <div class="flex items-center gap-1">
        <a
          href="https://github.com/incredible-zetta/crm"
          target="_blank"
          rel="noreferrer"
          aria-label="Zetta CRM on GitHub"
          class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }))}
        >
          <Icon name="github" size={18} />
        </a>
        <a
          href="https://twitter.com/"
          target="_blank"
          rel="noreferrer"
          aria-label="Zetta CRM on X"
          class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }))}
        >
          <Icon name="twitter" size={18} />
        </a>
        <a
          href="#rss"
          aria-label="Zetta CRM RSS feed"
          class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }))}
        >
          <Icon name="rss" size={18} />
        </a>
      </div>
    </div>

    <Separator />

    <p class="text-xs text-muted-foreground">
      A partnership between Incredible Zetta and Ciptadusa (CDS).
    </p>
  </div>
</footer>
