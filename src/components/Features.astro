---
import Icon from '../lib/Icon.astro';
import { FEATURES } from '../lib/data';
---

<section id="capabilities" class="border-b border-border py-20 sm:py-24">
  <div class="container-page mb-12 max-w-2xl">
    <h2 data-reveal class="text-3xl font-semibold tracking-tight sm:text-4xl">
      What agents can do
    </h2>
    <p data-reveal class="mt-3 text-base leading-relaxed text-muted-foreground">
      One MCP endpoint covers the full CRM loop — from contact to campaign to inbox to social channels — without bolting on another SaaS.
    </p>
  </div>

  <div data-stack class="container-page space-y-4 lg:space-y-6">
    {FEATURES.map((f) => (
      <article
        data-stack-panel
        data-reveal
        class="grid gap-5 border border-border bg-background/80 p-6 backdrop-blur-sm sm:grid-cols-[auto_1fr] sm:gap-8 sm:p-8 lg:sticky lg:top-24"
      >
        <span class="inline-flex size-11 items-center justify-center bg-muted text-foreground">
          <Icon name={f.icon as any} size={20} />
        </span>
        <div class="min-w-0 space-y-4">
          <div class="space-y-2">
            <h3 class="text-xl font-semibold tracking-tight">{f.title}</h3>
            <p class="max-w-2xl text-pretty text-sm leading-relaxed text-muted-foreground sm:text-base">
              {f.desc}
            </p>
          </div>
          <ul class="grid gap-2 sm:grid-cols-2">
            {f.points.map((point) => (
              <li class="flex items-start gap-2 text-sm text-muted-foreground">
                <span class="mt-2 size-1 shrink-0 rounded-full bg-foreground/40" aria-hidden="true" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>
