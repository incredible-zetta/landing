---
import Icon from '../lib/Icon.astro';
import { FEATURES } from '../lib/data';
import { Card, CardDescription, CardHeader, CardTitle } from '~/components/ui/card';
---

<section id="features" class="container-page pb-16">
  <div class="mb-8 max-w-2xl">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">MCP tools</h2>
    <p class="mt-2 text-sm text-muted-foreground sm:text-base">
      Agent-ready CRM operations without bolting on another SaaS stack.
    </p>
  </div>

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
    {FEATURES.map((f) => (
      <Card size="sm" className="h-full">
        <CardHeader>
          <span class="mb-2 inline-flex size-9 items-center justify-center rounded-lg bg-muted text-foreground">
            <Icon name={f.icon as any} size={18} />
          </span>
          <CardTitle>{f.title}</CardTitle>
          <CardDescription className="text-pretty">{f.desc}</CardDescription>
        </CardHeader>
      </Card>
    ))}
  </div>
</section>
